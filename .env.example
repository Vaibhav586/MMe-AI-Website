# Copy to .env.local for local development. Set the same variables in Vercel > Project > Settings > Environment Variables.

# --- Audit / demo form (app/api/demo/route.ts). Setup steps: docs/demo-leads.md ---
# Required. Each request is POSTed here as JSON. Use a Google Apps Script web app that appends to a
# shared Google Sheet, or a CRM / Zapier / Make webhook. Without it the form shows an error instead of saving.
DEMO_LEADS_WEBHOOK_URL=
# Optional. Slack incoming webhook for the shared sales channel, so the whole team sees new leads.
DEMO_SLACK_WEBHOOK_URL=

# --- Booking widget on /thank-you ---
# Cal.com booking path, e.g. mme-ai/workflow-audit. Empty shows WhatsApp/email instead.
NEXT_PUBLIC_CAL_LINK=

# --- Analytics (loaded in production only; leave a value empty to skip that script) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Runs in consent mode until the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID. Loads only after "Accept".
NEXT_PUBLIC_CLARITY_ID=
# Meta Pixel ID. Loads only after "Accept".
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag partner ID. Loads only after "Accept".
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Customer login (/login, /portal). Setup steps: docs/login.md ---
# Random secret that encrypts session cookies. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client from Google Cloud Console > APIs & Services > Credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
